[run]
source = lab1_utils,lab2_utils,lab3_units
omit =
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:

[xml]
output = coverage.xml

[html]
directory = htmlcov